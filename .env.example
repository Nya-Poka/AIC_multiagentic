# ===== 运行模式 =====
# local: 本机 HTTP 闭环；platform: 梧桐 ACPs + HTTPS/mTLS + 身份绑定。
RESEARCH_MESH_MODE=local
RESEARCH_MESH_HOST=127.0.0.1
RESEARCH_MESH_IDENTITY_BINDING=false
RESEARCH_MESH_MTLS_ENABLED=false

# ===== 五个独立 Agent 身份与端点 =====
# Registry 审批后执行 agent sync，再把正式 AIC 填到这里。
RESEARCH_MESH_LEADER_AIC=local.research-mesh.leader
RESEARCH_MESH_LITERATURE_AIC=local.research-mesh.literature
RESEARCH_MESH_EXPERIMENT_AIC=local.research-mesh.experiment
RESEARCH_MESH_ANALYSIS_AIC=local.research-mesh.analysis
RESEARCH_MESH_REVIEW_AIC=local.research-mesh.review

# 本地默认值。平台部署时改成五个外部可访问的 HTTPS JSON-RPC URL。
RESEARCH_MESH_LEADER_URL=http://127.0.0.1:8000/rpc
RESEARCH_MESH_LITERATURE_URL=http://127.0.0.1:8011/rpc
RESEARCH_MESH_EXPERIMENT_URL=http://127.0.0.1:8012/rpc
RESEARCH_MESH_ANALYSIS_URL=http://127.0.0.1:8013/rpc
RESEARCH_MESH_REVIEW_URL=http://127.0.0.1:8014/rpc
# 使用统一反向代理时可只填基础地址；显式 *_URL 优先级更高。
RESEARCH_MESH_PUBLIC_BASE_URL=

# ===== Registry / ADP Discovery =====
# 平台模式不可留空；联调地址填写 https://wt.ioa.pub/discovery 。
RESEARCH_MESH_DISCOVERY_URL=
RESEARCH_MESH_DISCOVERY_TIMEOUT_SECONDS=15
# 比赛验收建议 false，避免平台发现失败时悄悄退回本地静态注册表。
RESEARCH_MESH_DISCOVERY_FALLBACK_LOCAL=true

# ===== ACPs CA 签发的 mTLS 证书 =====
# clientAuth 证书供 Leader 调用 Discovery 和 Partner；serverAuth 证书分别供五个服务监听。
RESEARCH_MESH_LEADER_CLIENT_CERT_FILE=
RESEARCH_MESH_LEADER_CLIENT_KEY_FILE=
RESEARCH_MESH_LEADER_CLIENT_TRUST_BUNDLE_FILE=

RESEARCH_MESH_LEADER_SERVER_CERT_FILE=
RESEARCH_MESH_LEADER_SERVER_KEY_FILE=
RESEARCH_MESH_LEADER_SERVER_TRUST_BUNDLE_FILE=
RESEARCH_MESH_LITERATURE_SERVER_CERT_FILE=
RESEARCH_MESH_LITERATURE_SERVER_KEY_FILE=
RESEARCH_MESH_LITERATURE_SERVER_TRUST_BUNDLE_FILE=
RESEARCH_MESH_EXPERIMENT_SERVER_CERT_FILE=
RESEARCH_MESH_EXPERIMENT_SERVER_KEY_FILE=
RESEARCH_MESH_EXPERIMENT_SERVER_TRUST_BUNDLE_FILE=
RESEARCH_MESH_ANALYSIS_SERVER_CERT_FILE=
RESEARCH_MESH_ANALYSIS_SERVER_KEY_FILE=
RESEARCH_MESH_ANALYSIS_SERVER_TRUST_BUNDLE_FILE=
RESEARCH_MESH_REVIEW_SERVER_CERT_FILE=
RESEARCH_MESH_REVIEW_SERVER_KEY_FILE=
RESEARCH_MESH_REVIEW_SERVER_TRUST_BUNDLE_FILE=

# ===== AMP 可观测性 =====
RESEARCH_MESH_AMP_ENABLED=false
RESEARCH_MESH_AMP_LOG_DIR=artifacts/amp
RESEARCH_MESH_AMP_HEARTBEAT_INTERVAL_SECONDS=30

# ===== ACS Provider 信息（Registry 审核前必须替换占位值） =====
RESEARCH_MESH_PROVIDER_COUNTRY_CODE=CN
RESEARCH_MESH_PROVIDER_ORGANIZATION=参赛团队待填写
RESEARCH_MESH_PROVIDER_DEPARTMENT=
# URL 的域名也必须出现在下面的 DOMAIN 登记中；没有合规官网时先留空。
RESEARCH_MESH_PROVIDER_URL=
# 此字段填写法律备案/许可证号，不是代码开源许可证。
RESEARCH_MESH_PROVIDER_LICENSE=
RESEARCH_MESH_PROVIDER_CONTACT_NAME=
RESEARCH_MESH_PROVIDER_CONTACT_EMAIL=
# ACS 中 endpoint 所在域名的备案/注册信息。
RESEARCH_MESH_PROVIDER_DOMAIN=
RESEARCH_MESH_PROVIDER_DOMAIN_REGISTRATION=
RESEARCH_MESH_PROVIDER_DOMAIN_REGISTRATION_TYPE=ICP

# ===== 真实文献检索 =====
# Crossref 官方 API 无需密钥；邮箱用于 polite pool 和异常联系。
CROSSREF_MAILTO=
RESEARCH_MESH_CROSSREF_BASE_URL=https://api.crossref.org
RESEARCH_MESH_CROSSREF_TIMEOUT_SECONDS=12
RESEARCH_MESH_CROSSREF_RETRIES=2
RESEARCH_MESH_LITERATURE_CACHE_TTL_SECONDS=900

# ===== 统一 LLM Gateway（默认禁用） =====
RESEARCH_MESH_LLM_PROVIDER=disabled
RESEARCH_MESH_LLM_BASE_URL=
RESEARCH_MESH_LLM_API_KEY=
RESEARCH_MESH_LLM_MODEL=
RESEARCH_MESH_LLM_TIMEOUT_SECONDS=60
RESEARCH_MESH_LLM_RETRIES=2
RESEARCH_MESH_LLM_MAX_TOKENS=4096
RESEARCH_MESH_LLM_ALLOW_MODEL_OVERRIDE=false
RESEARCH_MESH_LLM_GATEWAY_URL=http://127.0.0.1:8020
# 非本机部署必须使用强随机令牌。
RESEARCH_MESH_LLM_GATEWAY_TOKEN=

# ===== Leader 输入标准化 =====
# 默认随统一 LLM Provider 自动启用；显式设为 false 时只使用本地确定性转换。
# 两种模式均支持严格 JSON、StructuredDataItem、代码块/混合文本中的 JSON、
# 常见非标准 JSON 以及自然语言；LLM 模式会进一步提取研究目标与约束。
RESEARCH_MESH_INPUT_NORMALIZER_USE_LLM=true
