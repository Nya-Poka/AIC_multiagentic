RESEARCH_MESH_LEADER_AIC=local.research-mesh.leader
RESEARCH_MESH_LITERATURE_URL=http://127.0.0.1:8011/rpc
RESEARCH_MESH_EXPERIMENT_URL=http://127.0.0.1:8012/rpc
RESEARCH_MESH_ANALYSIS_URL=http://127.0.0.1:8013/rpc
RESEARCH_MESH_REVIEW_URL=http://127.0.0.1:8014/rpc
# Crossref 官方 API 无需密钥；填写邮箱可进入 polite pool 并便于服务方联系。
CROSSREF_MAILTO=
RESEARCH_MESH_CROSSREF_BASE_URL=https://api.crossref.org
RESEARCH_MESH_CROSSREF_TIMEOUT_SECONDS=12
RESEARCH_MESH_CROSSREF_RETRIES=2
RESEARCH_MESH_LITERATURE_CACHE_TTL_SECONDS=900
# 本地 HTTP 闭环关闭身份绑定；接入梧桐平台时必须改为 mTLS 并启用绑定。
RESEARCH_MESH_IDENTITY_BINDING=false
# 后续接入官方 ADP discovery-server 时填写。
RESEARCH_MESH_DISCOVERY_URL=
